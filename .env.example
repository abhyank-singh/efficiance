# Copy to `.env` for LOCAL use on your own machine. `.env` is git-ignored.
# On Render, set the same names in the dashboard instead.

# ---- AI provider (pick ONE) --------------------------------------------------
# A) Google Gemini: free tier available, key from https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash-lite

# B) Any OpenAI-compatible API (OpenAI, Groq, OpenRouter, ...):
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.1-8b-instant

# C) Fully local and free: Ollama (https://ollama.com), no key, nothing leaves your laptop.
#    First run:  ollama pull llama3.2
# AI_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.2

# ---- Google Calendar (personal build only; optional) ------------------------
# Never set these on the public demo: the server keeps ONE shared token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/google/callback

# ---- Local server ----------------------------------------------------------
SERVER_PORT=3001
